{
  "name": "learning-companion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "client",
    "server"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "predev": "npm run build -w @learning-companion/shared",
    "dev": "concurrently --kill-others -n shared,server,client \"npm run dev -w @learning-companion/shared\" \"npm run dev -w @learning-companion/server\" \"npm run dev -w @learning-companion/client\"",
    "build": "npm run build -w @learning-companion/shared && npm run build -w @learning-companion/server && npm run build -w @learning-companion/client",
    "pretypecheck": "npm run build -w @learning-companion/shared",
    "typecheck": "npm run typecheck --workspaces && tsc -p tsconfig.tools.json",
    "lint": "eslint . --max-warnings 0",
    "pretest": "npm run build -w @learning-companion/shared",
    "test": "npm run test --workspaces",
    "test:e2e": "playwright test",
    "db:offline": "node scripts/db-offline.mjs",
    "db:remote:dry-run": "node scripts/db-remote.mjs dry-run",
    "db:remote:push": "node scripts/db-remote.mjs push",
    "db:live": "node scripts/db-live.mjs",
    "guest:browser:live": "node scripts/guest-browser-live.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "pg": "^8.23.1",
    "supabase": "^2.120.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "5.0.3"
  }
}
